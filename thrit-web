<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>RABEL THRIFT – Fashion Keren, Harga Bersahabat!</title>
<meta name="description" content="Toko online thrift pilihan: hoodie, sweater, kemeja, jaket, kaos, dan celana dengan harga terjangkau.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--ink:#111;--paper:#fff;--g1:#f4f4f4;--g2:#e3e3e3;--g3:#8a8a8a;--g4:#444;--red:#c8102e;--r:10px}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{font-family:Inter,system-ui,sans-serif;color:var(--ink);background:var(--paper);line-height:1.6}
h1,h2,h3,.brand{font-family:Archivo,Inter,sans-serif;letter-spacing:-.02em}
img{max-width:100%;display:block}
button,input,select{font:inherit}
button{cursor:pointer;border:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--red);outline-offset:2px}
.wrap{max-width:1160px;margin:0 auto;padding:0 20px}
section{padding:72px 0}
h2{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:900;line-height:1.1;margin-bottom:8px}
.sub{color:var(--g3);margin-bottom:32px}
.btn{display:inline-block;background:var(--ink);color:#fff;padding:12px 24px;border-radius:999px;font-weight:600;text-decoration:none;transition:.2s}
.btn:hover{background:var(--red);transform:translateY(-2px)}
.btn.light{background:#fff;color:var(--ink)}
.btn.light:hover{background:var(--red);color:#fff}
.btn.line{background:transparent;color:var(--ink);border:2px solid var(--ink)}
.btn.line:hover{background:var(--ink);color:#fff}

/* navbar */
header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--g2)}
.nav{display:flex;align-items:center;justify-content:space-between;height:64px}
.brand{display:flex;align-items:center;gap:10px;font-weight:900;font-size:1.2rem;text-decoration:none}
.logo{width:36px;height:36px;border-radius:8px;background:var(--ink);color:#fff;display:grid;place-items:center;font-weight:900;font-size:1.1rem}
nav ul{display:flex;gap:28px;list-style:none}
nav a{text-decoration:none;font-weight:500;position:relative;padding:4px 0}
nav a::after{content:"";position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--red);transition:.25s}
nav a:hover::after{width:100%}
.nav-r{display:flex;align-items:center;gap:10px}
.cart-btn{position:relative;background:var(--g1);border-radius:999px;padding:9px 16px;font-weight:600;transition:.2s}
.cart-btn:hover{background:var(--g2)}
.badge{position:absolute;top:-6px;right:-4px;background:var(--red);color:#fff;font-size:.72rem;min-width:20px;height:20px;border-radius:10px;display:grid;place-items:center;padding:0 5px}
.burger{display:none;background:none;font-size:1.6rem;line-height:1}

/* hero */
.hero{background:var(--ink);color:#fff;padding:0;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:32px;min-height:560px}
.hero h1{font-size:clamp(2.6rem,7vw,5rem);font-weight:900;line-height:.98;margin-bottom:20px}
.hero p{color:#bbb;max-width:440px;margin-bottom:28px}
.hero-img{position:relative;height:100%;min-height:380px;display:grid;place-items:center}
.hero-img img{width:min(340px,80%);border-radius:var(--r);transform:rotate(4deg);transition:.4s;box-shadow:0 24px 60px rgba(0,0,0,.5)}
.hero-img img+img{position:absolute;width:min(220px,50%);left:2%;bottom:6%;transform:rotate(-7deg)}
.hero-img:hover img{transform:rotate(1deg) scale(1.03)}
.hero-img:hover img+img{transform:rotate(-3deg) scale(1.05)}
.hero-cta{display:flex;gap:12px;flex-wrap:wrap}

/* katalog */
.tools{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.tools input{flex:1;min-width:200px;padding:12px 18px;border:2px solid var(--g2);border-radius:999px;background:#fff}
.tools input:focus{border-color:var(--ink);outline:none}
.tools select{padding:12px 18px;border:2px solid var(--g2);border-radius:999px;background:#fff}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}
.chip{background:var(--g1);padding:8px 18px;border-radius:999px;font-weight:500;transition:.2s}
.chip:hover{background:var(--g2)}
.chip.on{background:var(--ink);color:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:24px}
.card{border-radius:var(--r);overflow:hidden;background:#fff;border:1px solid var(--g2);transition:.3s;display:flex;flex-direction:column}
.card:hover{transform:translateY(-6px);box-shadow:0 14px 32px rgba(0,0,0,.12)}
.pic{position:relative;overflow:hidden;background:var(--g1);aspect-ratio:5/6}
.pic img{width:100%;height:100%;object-fit:cover;transition:.4s}
.card:hover .pic img{transform:scale(1.07)}
.tags{position:absolute;top:10px;left:10px;display:flex;gap:6px;flex-wrap:wrap}
.tag{font-size:.72rem;font-weight:600;padding:3px 10px;border-radius:999px;background:#fff;color:var(--ink)}
.tag.new{background:var(--ink);color:#fff}
.tag.best{background:#ffd23f}
.tag.sale{background:var(--red);color:#fff}
.info{padding:14px 16px 16px;display:flex;flex-direction:column;gap:4px;flex:1}
.cat{color:var(--g3);font-size:.82rem}
.info h3{font-size:1.02rem;font-weight:600}
.price{font-weight:700}
.price s{color:var(--g3);font-weight:400;font-size:.88rem;margin-left:6px}
.info .btn{margin-top:auto;text-align:center;padding:10px}
.empty{grid-column:1/-1;text-align:center;color:var(--g3);padding:40px 0}

/* tentang */
.about{background:var(--g1)}
.about .wrap{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.about p{color:var(--g4);margin-bottom:14px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.stat{background:#fff;border-radius:var(--r);padding:22px 12px;text-align:center}
.stat b{font-family:Archivo;font-size:1.9rem;font-weight:900;display:block}
.stat span{color:var(--g3);font-size:.85rem}

/* testimoni */
.tgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}
.tcard{border:1px solid var(--g2);border-radius:var(--r);padding:24px;transition:.3s}
.tcard:hover{border-color:var(--ink);transform:translateY(-4px)}
.stars{color:#e0a800;letter-spacing:2px;margin-bottom:8px}
.tcard p{color:var(--g4);margin-bottom:14px}
.tcard b{display:block}
.tcard small{color:var(--g3)}

/* kontak */
.contact{background:var(--ink);color:#fff}
.contact .sub{color:#aaa}
.cgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}
.ccard{background:#1c1c1c;border-radius:var(--r);padding:22px;text-decoration:none;transition:.25s;display:block}
.ccard:hover{background:#2a2a2a;transform:translateY(-4px)}
.ccard b{display:block;margin-bottom:4px}
.ccard span{color:#aaa;font-size:.92rem}

footer{background:#0a0a0a;color:#999;padding:40px 0 24px;font-size:.9rem}
.fgrid{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:24px}
footer .brand{color:#fff;margin-bottom:8px}
footer ul{list-style:none;display:flex;gap:20px;flex-wrap:wrap}
footer a{text-decoration:none}
footer a:hover{color:#fff}
.copy{border-top:1px solid #222;padding-top:18px;text-align:center}

/* modal + keranjang */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:80;display:none}
.overlay.open{display:block}
.modal{position:fixed;z-index:90;top:50%;left:50%;transform:translate(-50%,-50%);width:min(860px,94vw);max-height:92vh;overflow:auto;background:#fff;border-radius:14px;display:none;grid-template-columns:1fr 1fr}
.modal.open{display:grid;animation:pop .22s ease}
@keyframes pop{from{opacity:0;transform:translate(-50%,-47%)}}
.modal .pic{aspect-ratio:auto;min-height:320px}
.mbody{padding:28px;display:flex;flex-direction:column;gap:12px}
.mbody h3{font-size:1.6rem;font-weight:800}
.mbody .price{font-size:1.4rem}
.meta{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.meta div{background:var(--g1);border-radius:8px;padding:10px 12px;font-size:.88rem}
.meta b{display:block;font-size:.78rem;color:var(--g3);font-weight:500}
.close{position:absolute;top:10px;right:12px;z-index:2;background:#fff;width:36px;height:36px;border-radius:50%;font-size:1.3rem;box-shadow:0 2px 8px rgba(0,0,0,.2)}
.close:hover{background:var(--g2)}
.mact{display:flex;gap:10px;flex-wrap:wrap;margin-top:auto}
.mact .btn{flex:1;text-align:center}
.drawer{position:fixed;z-index:90;top:0;right:0;height:100%;width:min(410px,100%);background:#fff;transform:translateX(100%);transition:.3s;display:flex;flex-direction:column}
.drawer.open{transform:none}
.dh{display:flex;justify-content:space-between;align-items:center;padding:18px 20px;border-bottom:1px solid var(--g2)}
.dh h3{font-size:1.3rem}
.dh .close{position:static;box-shadow:none;background:var(--g1)}
.items{flex:1;overflow:auto;padding:12px 20px}
.item{display:grid;grid-template-columns:64px 1fr auto;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--g1)}
.item img{width:64px;height:76px;object-fit:cover;border-radius:8px}
.item b{font-size:.95rem;display:block}
.item small{color:var(--g3)}
.qty{display:flex;align-items:center;gap:8px;margin-top:4px}
.qty button{width:26px;height:26px;border-radius:50%;background:var(--g1);font-weight:700}
.qty button:hover{background:var(--g2)}
.del{background:none;color:var(--red);font-size:.82rem;text-decoration:underline}
.df{padding:18px 20px;border-top:1px solid var(--g2)}
.total{display:flex;justify-content:space-between;font-weight:800;font-size:1.2rem;margin-bottom:12px}
.df .btn{width:100%;text-align:center;background:#25d366;color:#fff}
.df .btn:hover{background:#1da851}
.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,80px);background:var(--ink);color:#fff;padding:12px 22px;border-radius:999px;z-index:100;transition:.3s;opacity:0;pointer-events:none}
.toast.show{transform:translate(-50%,0);opacity:1}

@media(max-width:820px){
 .burger{display:block}
 nav{position:absolute;top:64px;left:0;right:0;background:#fff;border-bottom:1px solid var(--g2);display:none}
 nav.open{display:block}
 nav ul{flex-direction:column;gap:0;padding:8px 20px}
 nav li a{display:block;padding:12px 0}
 .hero .wrap{grid-template-columns:1fr;padding-top:48px;padding-bottom:20px}
 .hero-img{min-height:340px}
 .about .wrap{grid-template-columns:1fr}
 .modal.open{grid-template-columns:1fr}
 .modal .pic{min-height:260px;aspect-ratio:1}
 section{padding:52px 0}
 .grid{grid-template-columns:repeat(2,1fr);gap:14px}
 .info{padding:10px 12px 12px}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
