<script>
/* ============ PENGATURAN (edit di sini) ============ */
const CONFIG = {
  wa: "6281234567890",          // nomor WhatsApp admin, format 62xxxxxxxxxx tanpa + atau 0
  instagram: "https://instagram.com/rabelthrift",
  tiktok: "https://tiktok.com/@rabelthrift",
  alamat: "Jl. Contoh Raya No. 12, Kota Anda (ganti dengan alamat toko)"
};

/* ============ DATA PRODUK ============
   img: isi dengan path foto sendiri, contoh "foto/hoodie1.jpg".
   Jika dikosongkan, otomatis dibuat gambar ilustrasi.
   old: harga sebelum diskon (opsional). tag: "new" / "best" (opsional). */
const PRODUCTS = [
 {id:1, name:"Hoodie Oversize Washed Black", cat:"Hoodie", price:95000, old:130000, size:"L", cond:"Sangat baik (9/10)", color:"#2b2b2b", tag:"best", img:"", desc:"Hoodie hitam washed, bahan fleece tebal dan lembut. Tidak ada noda atau sobek."},
 {id:2, name:"Hoodie Zip Grey Vintage", cat:"Hoodie", price:105000, size:"XL", cond:"Baik (8/10)", color:"#8d8d8d", tag:"new", img:"", desc:"Hoodie zip abu-abu gaya vintage, resleting lancar. Ada sedikit pudar wajar di bagian lengan."},
 {id:3, name:"Sweater Rajut Cream", cat:"Sweater", price:85000, size:"M", cond:"Sangat baik (9/10)", color:"#d9d3c7", tag:"new", img:"", desc:"Sweater rajut warna cream, hangat dan tidak gatal. Rajutan masih rapat."},
 {id:4, name:"Crewneck Stripe Navy", cat:"Sweater", price:75000, old:99000, size:"L", cond:"Baik (8/10)", color:"#2f3b52", img:"", desc:"Crewneck belang navy putih, potongan boxy yang santai."},
 {id:5, name:"Kemeja Flanel Kotak Merah", cat:"Kemeja", price:70000, size:"L", cond:"Baik (8/10)", color:"#a3262a", tag:"best", img:"", desc:"Kemeja flanel kotak merah hitam, bahan tebal dan nyaman."},
 {id:6, name:"Kemeja Putih Oxford", cat:"Kemeja", price:65000, old:85000, size:"M", cond:"Sangat baik (9/10)", color:"#f1f1ee", img:"", desc:"Kemeja oxford putih bersih, cocok untuk kasual maupun semi-formal."},
 {id:7, name:"Jaket Denim Washed Blue", cat:"Jaket", price:145000, size:"L", cond:"Baik (8/10)", color:"#4a6a8f", tag:"best", img:"", desc:"Jaket denim biru washed, kancing lengkap, jahitan kuat."},
 {id:8, name:"Jaket Coach Hitam", cat:"Jaket", price:125000, old:160000, size:"XL", cond:"Sangat baik (9/10)", color:"#1a1a1a", tag:"new", img:"", desc:"Coach jacket hitam tahan angin, lapisan dalam utuh."},
 {id:9, name:"Kaos Band Vintage 90s", cat:"Kaos", price:80000, size:"L", cond:"Baik (8/10)", color:"#3a3a3a", tag:"new", img:"", desc:"Kaos bergaya band vintage dengan sablon retro. Tampilan pudar alami."},
 {id:10, name:"Kaos Polos Boxy Putih", cat:"Kaos", price:45000, old:60000, size:"M", cond:"Sangat baik (9/10)", color:"#ececec", img:"", desc:"Kaos putih polos potongan boxy, katun adem."},
 {id:11, name:"Celana Cargo Olive", cat:"Celana", price:110000, size:"32", cond:"Baik (8/10)", color:"#6b6b45", tag:"best", img:"", desc:"Celana cargo olive dengan banyak kantong. Ukuran pinggang 32."},
 {id:12, name:"Celana Jeans Straight Hitam", cat:"Celana", price:100000, old:135000, size:"30", cond:"Sangat baik (9/10)", color:"#222", img:"", desc:"Jeans hitam potongan straight, stretch ringan. Ukuran pinggang 30."}
];
const CATS = ["Semua","Hoodie","Sweater","Kemeja","Jaket","Kaos","Celana"];

/* ============ HELPER ============ */
const $ = s => document.querySelector(s);
const rp = n => "Rp " + n.toLocaleString("id-ID");
const find = id => PRODUCTS.find(p => p.id === id);
function pic(p){
  if(p.img) return p.img;
  const light = /^#(e|f|d)/i.test(p.color);
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 360"><rect width="300" height="360" fill="#f0f0f0"/><path d="M95 50l-65 42 28 50 32-20v178h120V122l32 20 28-50-65-42c-8 24-30 36-60 36s-52-12-60-36z" fill="${p.color}" stroke="${light?'#cfcfcf':'none'}" stroke-width="2"/><text x="150" y="210" text-anchor="middle" font-family="Arial" font-weight="700" font-size="22" fill="${light?'#555':'#fff'}" opacity=".85">${p.cat}</text></svg>`;
  return "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svg);
}
function toast(msg){const t=$("#toast");t.textContent=msg;t.classList.add("show");clearTimeout(toast.t);toast.t=setTimeout(()=>t.classList.remove("show"),1800)}

/* ============ KATALOG ============ */
let activeCat = "Semua";
function renderChips(){
  $("#chips").innerHTML = CATS.map(c=>`<button class="chip ${c===activeCat?'on':''}" data-cat="${c}">${c}</button>`).join("");
}
function renderGrid(){
  const q = $("#search").value.trim().toLowerCase();
  let list = PRODUCTS.filter(p => (activeCat==="Semua"||p.cat===activeCat) && (p.name+" "+p.cat+" "+p.desc).toLowerCase().includes(q));
  const s = $("#sort").value;
  const disc = p => p.old ? (p.old-p.price)/p.old : 0;
  if(s==="low") list.sort((a,b)=>a.price-b.price);
  if(s==="high") list.sort((a,b)=>b.price-a.price);
  if(s==="sale") list.sort((a,b)=>disc(b)-disc(a));
  $("#grid").innerHTML = list.length ? list.map(p=>{
    const d = p.old ? Math.round(disc(p)*100) : 0;
    return `<article class="card">
      <div class="pic"><img src="${pic(p)}" alt="${p.name}" loading="lazy">
        <div class="tags">${p.tag==="new"?'<span class="tag new">Terbaru</span>':''}${p.tag==="best"?'<span class="tag best">Terlaris</span>':''}${d?`<span class="tag sale">-${d}%</span>`:''}</div></div>
      <div class="info"><span class="cat">${p.cat}</span><h3>${p.name}</h3>
        <div class="price">${rp(p.price)}${p.old?`<s>${rp(p.old)}</s>`:''}</div>
        <button class="btn line" data-detail="${p.id}">Lihat detail</button></div>
    </article>`}).join("") : `<p class="empty">Produk tidak ditemukan. Coba kata kunci atau kategori lain.</p>`;
}

/* ============ DETAIL ============ */
function openDetail(id){
  const p = find(id);
  $("#modal").innerHTML = `<button class="close" data-close aria-label="Tutup">×</button>
   <div class="pic"><img src="${pic(p)}" alt="${p.name}"></div>
   <div class="mbody">
    <span class="cat">${p.cat}</span><h3>${p.name}</h3>
    <div class="price">${rp(p.price)}${p.old?`<s>${rp(p.old)}</s>`:''}</div>
    <p>${p.desc}</p>
    <div class="meta"><div><b>Ukuran</b>${p.size}</div><div><b>Kondisi</b>${p.cond}</div></div>
    <div class="mact">
     <button class="btn line" data-add="${p.id}">Tambah ke keranjang</button>
     <button class="btn" data-buy="${p.id}">Beli sekarang</button>
    </div></div>`;
  $("#modal").classList.add("open"); $("#overlay").classList.add("open");
}
function closeAll(){
  ["#modal","#overlay","#drawer"].forEach(s=>$(s).classList.remove("open"));
}

/* ============ KERANJANG ============ */
let cart = [];
try{ cart = JSON.parse(localStorage.getItem("rabel_cart")||"[]").filter(i=>find(i.id)); }catch(e){ cart = []; }
function save(){ try{ localStorage.setItem("rabel_cart", JSON.stringify(cart)); }catch(e){} }
function add(id){
  const it = cart.find(i=>i.id===id);
  it ? it.qty++ : cart.push({id, qty:1});
  renderCart(); toast("Ditambahkan ke keranjang");
}
function changeQty(id, d){
  const it = cart.find(i=>i.id===id); if(!it) return;
  it.qty += d; if(it.qty<=0) cart = cart.filter(i=>i.id!==id);
  renderCart();
}
function remove(id){ cart = cart.filter(i=>i.id!==id); renderCart(); }
function renderCart(){
  const total = cart.reduce((s,i)=>s+find(i.id).price*i.qty,0);
  const n = cart.reduce((s,i)=>s+i.qty,0);
  $("#count").textContent = n;
  $("#total").textContent = rp(total);
  $("#items").innerHTML = cart.length ? cart.map(i=>{
    const p = find(i.id);
    return `<div class="item"><img src="${pic(p)}" alt="${p.name}">
      <div><b>${p.name}</b><small>Ukuran ${p.size} · ${rp(p.price)}</small>
       <div class="qty"><button data-dec="${p.id}" aria-label="Kurangi">−</button><span>${i.qty}</span><button data-inc="${p.id}" aria-label="Tambah">+</button></div></div>
      <button class="del" data-del="${p.id}">Hapus</button></div>`}).join("")
    : `<p class="empty">Keranjang masih kosong. Yuk pilih produk dulu.</p>`;
  const co = $("#checkout");
  co.style.opacity = cart.length ? 1 : .45;
  co.setAttribute("href", cart.length ? waLink(total) : "#");
  save();
}
function waLink(total){
  let m = "Halo admin RABEL THRIFT, saya mau pesan:\n\n";
  cart.forEach((i,k)=>{ const p=find(i.id); m += `${k+1}. ${p.name} (ukuran ${p.size}) x${i.qty} = ${rp(p.price*i.qty)}\n`; });
  m += `\nTotal: ${rp(total)}\n\nMohon info ketersediaan, ongkir, dan cara pembayarannya. Terima kasih!`;
  return `https://wa.me/${CONFIG.wa}?text=${encodeURIComponent(m)}`;
}
function openCart(){ $("#drawer").classList.add("open"); $("#overlay").classList.add("open"); }

/* ============ EVENT ============ */
document.addEventListener("click", e=>{
  const t = e.target.closest("button, a"); if(!t) return;
  if(t.dataset.cat){ activeCat=t.dataset.cat; renderChips(); renderGrid(); }
  else if(t.dataset.detail) openDetail(+t.dataset.detail);
  else if(t.dataset.add){ add(+t.dataset.add); }
  else if(t.dataset.buy){ add(+t.dataset.buy); closeAll(); openCart(); }
  else if(t.dataset.inc) changeQty(+t.dataset.inc,1);
  else if(t.dataset.dec) changeQty(+t.dataset.dec,-1);
  else if(t.dataset.del) remove(+t.dataset.del);
  else if(t.dataset.close !== undefined) closeAll();
  else if(t.id==="checkout" && !cart.length){ e.preventDefault(); toast("Keranjang masih kosong"); }
  if(t.closest("#menu a")) $("#menu").classList.remove("open");
});
$("#overlay").onclick = closeAll;
$("#closeCart").onclick = closeAll;
$("#openCart").onclick = openCart;
$("#burger").onclick = ()=>$("#menu").classList.toggle("open");
$("#search").oninput = renderGrid;
$("#sort").onchange = renderGrid;
document.addEventListener("keydown", e=>{ if(e.key==="Escape") closeAll(); });

/* ============ INISIALISASI ============ */
$("#heroImg").innerHTML = `<img src="${pic(PRODUCTS[6])}" alt="Jaket denim thrift"><img src="${pic(PRODUCTS[0])}" alt="Hoodie thrift">`;
$("#lIg").href = CONFIG.instagram;
$("#lTk").href = CONFIG.tiktok;
$("#lWa").href = `https://wa.me/${CONFIG.wa}`;
$("#waText").textContent = "+" + CONFIG.wa;
$("#addr").textContent = CONFIG.alamat;
$("#year").textContent = new Date().getFullYear();
renderChips(); renderGrid(); renderCart();
</script>
</body>
</html>
